GEMINI_API_KEY=your-gemini-api-key-here
# Agent 3 (records) model override. Gemini 2.5 Pro is NOT available on the free
# tier (quota limit 0). With a free key, set this to gemini-2.5-flash so document
# uploads work. Leave unset on a billing-enabled key to use Pro.
GEMINI_PRO_MODEL=
POSTGRES_PASSWORD=change-this-strong-password
SESSION_SECRET=change-this-random-secret-32-chars
DOMAIN=your-domain-or-server-ip
CORS_ORIGINS=https://your-domain-or-server-ip

# Redis cache (cache-aside layer for LLM results). Optional: if unset, the app
# runs cache-less. Defaults to the bundled docker-compose redis service.
# For a managed instance (e.g. Vultr Managed Redis/Valkey) use a TLS URL:
#   REDIS_URL=rediss://default:password@host:port/0
REDIS_URL=redis://redis:6379/0

# ── Celery (reminder scheduling + delivery) ───────────────────────────────────
# Redis is dual-purpose: cache on db 0, Celery broker on db 1, results on db 2.
# NOTE: the bundled Redis uses allkeys-lru eviction (fine for dev). For production,
# run a SEPARATE Redis with noeviction for the broker so queued tasks are never lost.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# How often Beat scans for due reminders, in seconds.
REMINDER_DISPATCH_INTERVAL=60

# ── Auth (Phase 0) ────────────────────────────────────────────────────────────
# APP_ENV=production makes the backend refuse to start unless JWT_SECRET or
# SESSION_SECRET is set (never runs on the insecure dev fallback secret).
# docker-compose defaults this to production; set to development for local runs.
APP_ENV=production
# Internal testing endpoints (e.g. POST /companion/checkin). Keep false in
# production; set true in dev/staging to simulate scheduled check-ins.
ENABLE_TEST_ENDPOINTS=false
# JWT signing secret for access tokens. Falls back to SESSION_SECRET if unset.
JWT_SECRET=change-this-random-secret-32-chars
# Field-level encryption key for health data at rest (Fernet). REQUIRED in
# production (the backend refuses to start without it). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: losing this key makes the encrypted health data unrecoverable.
# Store it in a secret manager and back it up alongside database backups.
VERA_ENCRYPTION_KEY=
# Base URL of the app, used for email verification / reset links and OAuth redirects.
APP_BASE_URL=http://localhost
# Set to true in production (HTTPS) so cookies are marked Secure.
COOKIE_SECURE=false

# Google OAuth (optional — sign-in with Google is disabled if unset).
# Authorized redirect URI in Google Cloud must match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# Transactional email (optional — verification/reset links are logged if unset).
# EMAIL_PROVIDER: resend | sendgrid
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=VERA <no-reply@vera.health>

# Twilio — SMS + WhatsApp reminders and phone-OTP verification (optional).
# Unset = dev-safe: messages/codes are logged instead of sent. Free trial works.
# WhatsApp: use the Twilio sandbox number for testing, e.g. whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
