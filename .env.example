# ── AI Partners ──────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Backend ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Change this to a long random string in production
SESSION_SECRET=change-this-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector — set by docker-compose automatically
# For local dev outside Docker: postgresql://vera:vera_dev@localhost:5432/vera
DATABASE_URL=postgresql://vera:vera_dev@localhost:5432/vera
POSTGRES_PASSWORD=vera_dev

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend URL for Next.js server-side API proxy
BACKEND_URL=http://localhost:8000

# ── Deployment (Vultr) ───────────────────────────────────────────────────────
VULTR_REGION=blr1
